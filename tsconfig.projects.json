{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2022"], "noEmit": true, "strict": true,
    "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "isolatedModules": true, "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"], "allowImportingTsExtensions": true
  },
  "include": ["static/project-catalog.ts", "static/projects.ts", "static/work-*.ts", "tools/project-snapshot.ts", "tools/project-observation.ts"]
}
