; Tests of mesh-sessions. No real process is read (fictional tables, Fake)
; and every file lives in a fresh temporary directory; the program test runs
; the built executable with HOME pointing there.

(library
 (name mesh_sessions_test_support)
 (wrapped false)
 (modules fake)
 (libraries
  mesh_agent
  mesh_agent_claude
  mesh_platform
  mesh_pty_processes
  yojson
  unix))

