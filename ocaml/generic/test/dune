; Tests of the generic libraries, one executable per library. Deterministic:
; Eio tests run on mock clocks, the system-thread test waits on a gate it
; opens itself, file tests use a fresh temporary directory, and properties use
; a fixed seed.

(library
 (name generic_test_support)
 (wrapped false)
 (modules support)
 (libraries qcheck-core unix))

(test
 (name test_lru)
 (modules test_lru)
 (libraries mesh_lru generic_test_support alcotest qcheck-core))

(test
 (name test_priority)
 (modules test_priority)
 (libraries mesh_priority generic_test_support alcotest qcheck-core))

(test
 (name test_jsonl)
 (modules test_jsonl)
 (libraries mesh_jsonl generic_test_support alcotest qcheck-core yojson))

(test
 (name test_safe_file)
 (modules test_safe_file)
 (libraries mesh_safe_file generic_test_support alcotest unix))

(test
 (name test_jsonl_tail)
 (modules test_jsonl_tail)
 (libraries
  mesh_jsonl_tail
  mesh_safe_file
  generic_test_support
  alcotest
  qcheck-core
  yojson
  unix))

(test
 (name test_deadline_pool)
 (modules test_deadline_pool)
 (libraries
  mesh_deadline_pool
  mesh_priority
  alcotest
  eio
  eio.mock
  eio_main
  threads.posix))

(test
 (name test_jsonl_rpc)
 (modules test_jsonl_rpc)
 (libraries mesh_jsonl_rpc mesh_jsonl alcotest eio eio.mock yojson))

; The independence rule of the generic libraries (ocaml/README.md, "Generic
; libraries"): their dune files may name only each other and an allowed list
; of general-purpose packages. The self-test injects each kind of violation in
; a temporary copy of generic/ and expects the guard to refuse it.

(library
 (name generic_guard)
 (modules generic_guard))

(executable
 (name dependency_guard)
 (modules dependency_guard)
 (libraries generic_guard))

(rule
 (alias runtest)
 (deps
  (glob_files_rec ../dune))
 (action
  (run %{exe:dependency_guard.exe} ..)))

(test
 (name test_generic_guard)
 (modules test_generic_guard)
 (libraries generic_guard generic_test_support alcotest unix)
 (deps
  (glob_files_rec ../dune))
 (action
  (run %{test} ..)))
