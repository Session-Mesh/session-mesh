; Tests of the generic libraries, one executable per library. Deterministic:
; Eio tests run on mock clocks, the system-thread test waits on a gate it
; opens itself, file tests use a fresh temporary directory, and properties use
; a fixed seed.

(library
 (name generic_test_support)
 (wrapped false)
 (modules support)
 (libraries qcheck-core unix))

(test
 (name test_lru)
 (modules test_lru)
 (libraries mesh_lru generic_test_support alcotest qcheck-core))

(test
 (name test_priority)
 (modules test_priority)
 (libraries mesh_priority generic_test_support alcotest qcheck-core))

(test
 (name test_jsonl)
 (modules test_jsonl)
 (libraries mesh_jsonl generic_test_support alcotest qcheck-core yojson))

(test
 (name test_safe_file)
 (modules test_safe_file)
 (libraries mesh_safe_file generic_test_support alcotest unix))

(test
 (name test_jsonl_tail)
 (modules test_jsonl_tail)
 (libraries
  mesh_jsonl_tail
  mesh_safe_file
  generic_test_support
  alcotest
  qcheck-core
  yojson
  unix))
