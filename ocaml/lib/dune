  lwt
  lwt.unix
  yojson
  unix
  mesh_demo_scene
  mesh_agent_guide))

; agent-guide.md is a byte-for-byte copy of docs/agent-guide.md, an ordinary
; file kept in this dune project so the package builds on its own
; (tests/agent-guide-copy.test.ts fails when the two differ). It is embedded
; at build time: mesh-board-mcp locates no data file at run time.

(library
 (name mesh_agent_guide)
 (modules mesh_agent_guide mesh_agent_guide_text)
 (libraries mcp-kit))

(rule
 (target mesh_agent_guide_text.ml)
 (deps agent-guide.md)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let text = {mesh_agent_guide|")
    (cat agent-guide.md)
    (echo "|mesh_agent_guide}\n")))))

