; The Python harness starts the host that MESH_PTYHOST_CMD names, the built one in
; scripts/bootstrap.sh: depend on it, or the test can run while this build replaces it.
(test
 (name ptyhost_interop)
 (modules ptyhost_interop)
 (libraries mesh_wire mesh_platform unix yojson)
 (deps ../../bin/mesh_ptyhost_main.exe))

(rule
 (alias runtest)
 (action
  (run %{exe:ptyhost_interop.exe} --diagnostic-test)))

; The opam package quint-connect (>= 0.3.0, a test dependency) installs the findlib
; library ocaml-quint-connect: the replay runs where it is installed and is
; skipped elsewhere.

(test
 (name ptyhost_lifecycle_itf)
 (modules ptyhost_lifecycle_itf)
 (build_if %{lib-available:ocaml-quint-connect})
 (libraries mesh_wire mesh_platform ocaml-quint-connect alcotest unix yojson)
 (deps ptyhost_lifecycle.qnt ptyhost_lifecycle.itf.json))
