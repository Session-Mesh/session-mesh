set -euo pipefail
entry=$0
while [[ -L $entry ]]; do
  parent=$(cd -P "$(dirname "$entry")" && pwd)
  link=$(readlink "$entry")
  case $link in /*) entry=$link ;; *) entry=$parent/$link ;; esac
done
MESH_BUNDLE_ROOT=$(cd "$(dirname "$entry")/.." && pwd)
# shellcheck source=scripts/bundle/env.sh
source "$MESH_BUNDLE_ROOT/env.sh"
exec "$MESH_PYTHON" "$MESH_BUNDLE_ROOT/app/bin/$(basename "$0")" "$@"
