# fake-gh — a stub `gh` used by the tests/*.test.sh: every call reads JSON or text
# from fixtures/<tool>/ (FIXTURES must be set), so the tools' output is deterministic.
# It models the real gh where it matters:
# - repo-targeting calls MUST pass -R <REPO> (env, default Session-Mesh/session-mesh),
#   else exit 65 (api calls must stay inside repos/<REPO>/...);
# - pr checks: TSV name/state/duration/url rows; a PR with no checks exits 1 with no
#   output (fixture file missing); cancelled state is written `cancel`;
# - run list: several runs of DIFFERENT heads; run view uses per-run fixtures
#   (jobs-<id>.json, log-failed-<id>.txt) whose first line starts with a BOM;
# - pr view of a non-numeric argument "follows the URL" (real gh ignores -R then),
#   so any tool that lets a non-numeric PR number through gets surprised;
# - pr merge requires --rebase and --match-head-commit set to the head the tool read
#   at the start (the fixture headRefOid, or the first head served when head-moves-<n>
#   exists, which models a push between the gate and the merge);
# - api --paginate serves files-<n>-p1.json, -p2.json, ... when present;
# - api branches/<base> serves branch-<base with / replaced by _>.json.
set -euo pipefail
FIXTURES=${FIXTURES:?FIXTURES must be set}
EXPECTED_REPO=${REPO:-Session-Mesh/session-mesh}
STATE=${TEST_LIB_SCRATCH:-$(mktemp -d)}

jqexpr=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    if [ "${args[i]}" = "--jq" ]; then
        jqexpr="${args[i + 1]:-}"
    fi
done

check_repo_flag() {
    local i val=""
    for ((i = 0; i < ${#args[@]}; i++)); do
        if [ "${args[i]}" = "-R" ]; then
            val="${args[i + 1]:-}"
        fi
    done
    if [ "$val" != "$EXPECTED_REPO" ]; then
        echo "fake-gh: repo-targeting call without -R $EXPECTED_REPO" >&2
        exit 65
    fi
}

check_repo_path() {
    local path=${1:-}
    case $path in
        "repos/$EXPECTED_REPO/"*) ;;
        *) echo "fake-gh: api call outside repos/$EXPECTED_REPO: $path" >&2; exit 65 ;;
    esac
}

apply_jq() {
    local name=$1
    if [ -n "$jqexpr" ]; then
        jq -r "$jqexpr" "$FIXTURES/$name"
    else
        cat "$FIXTURES/$name"
    fi
}

has_arg() {
    local a
    for a in "${args[@]}"; do
        [ "$a" = "$1" ] && return 0
    done
    return 1
}

after_arg() {
    local i
    for ((i = 0; i < ${#args[@]} - 1; i++)); do
        if [ "${args[i]}" = "$1" ]; then
            printf '%s\n' "${args[i + 1]}"
            return
        fi
    done
    return 1
}

pr_arg() {
    local i
    for ((i = 2; i < ${#args[@]}; i++)); do
        case ${args[i]} in
            -[A-Za-z]*) continue ;;
        esac
        printf '%s\n' "${args[i]}"
        return
    done
    return 1
}

pr_num() {
    local a
    a=$(pr_arg) || return 1
    if [[ $a =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$a"
    else
        # Real gh follows a URL and ignores -R; model the surprise it gives.
        printf '%s\n' '999999'
    fi
}

serve_view() {
    local n=$1 head f
    head=$(jq -r .headRefOid "$FIXTURES/pr-view-$n.json" 2>/dev/null || true)
    if [ -e "$FIXTURES/head-moves-$n" ] && [ -f "$STATE/seen-head-$n" ]; then
        # The head moved: every later view of this PR shows a different head.
        f="$STATE/pr-view-$n-moved.json"
        jq '.headRefOid = "f9c45553aaaaaaaabbbbbbbbccccccccdddddddd"' "$FIXTURES/pr-view-$n.json" > "$f"
        if [ -n "$jqexpr" ]; then
            jq -r "$jqexpr" "$f"
        else
            cat "$f"
        fi
        return
    fi
    if [ -e "$FIXTURES/head-moves-$n" ]; then
        printf '%s' "$head" > "$STATE/seen-head-$n"
    fi
    apply_jq "pr-view-$n.json"
}

head_current() {
    local n
    n=$(pr_num)
    if [ -e "$FIXTURES/head-moves-$n" ] && [ -f "$STATE/seen-head-$n" ]; then
        printf 'f9c45553aaaaaaaabbbbbbbbccccccccdddddddd\n'
    else
        jq -r .headRefOid "$FIXTURES/pr-view-$n.json"
    fi
}

branch_json() {
    # The --branch value decides the fixture file, slashes become underscores.
    local b f
    b=$(after_arg --branch) || return 1
    f="run-$(printf '%s' "$b" | tr '/' '_').json"
    [ -f "$FIXTURES/$f" ] || return 1
    apply_jq "$f"
}

cmd=${1:?}
sub=${2:-}
case "$cmd" in
    pr)
        check_repo_flag
        if [ -e "$FIXTURES/view-fails" ]; then
            echo 'gh: could not resolve the repository' >&2
            exit 3
        fi
        case "$sub" in
            list)
                if [ -e "$FIXTURES/pr-list-fails" ]; then
                    echo 'gh: HTTP 502: bad gateway' >&2
                    exit 2
                fi
                # Real gh honors --limit (30 without it);
                # the --jq expression still applies to the limited list.
                if lim=$(after_arg --limit); then
                    [ -n "$lim" ] || lim=30
                else
                    lim=30
                fi
                if [ -n "$jqexpr" ]; then
                    jq -r --argjson lim "$lim" "(.[0:$lim]) | $jqexpr" "$FIXTURES/pr-list.json"
                else
                    jq --argjson lim "$lim" '.[0:$lim]' "$FIXTURES/pr-list.json"
                fi
                ;;
            checks)
                # gh exits 0 with every check green, 8 when one is pending, and 1 both
                # when a check failed and for a PR without any check (output empty). An
                # API error also exits 1 with a message (the fixture flag models it).
                n=$(pr_num)
                if [ -e "$FIXTURES/checks-$n-apifail" ]; then
                    echo 'gh: HTTP 502: bad gateway' >&2
                    exit 1
                fi
                if [ -f "$FIXTURES/checks-$n.txt" ]; then
                    cat "$FIXTURES/checks-$n.txt"
                    state_column=$(cut -f2 "$FIXTURES/checks-$n.txt")
                    if printf '%s\n' "$state_column" | grep -qE '^(fail|cancel)$'; then
                        exit 1
                    elif printf '%s\n' "$state_column" | grep -qE '^(pending)$'; then
                        exit 8
                    fi
                else
                    echo 'gh: no checks reported on the pull request' >&2
                    exit 1
                fi
                ;;
            view) serve_view "$(pr_num)" ;;
            diff)
                # A fixture file named diff-fails-<n> makes this call fail, as gh does.
                if [ -e "$FIXTURES/diff-fails-$(pr_num)" ]; then
                    echo 'gh: the diff is too large to render' >&2
                    exit 1
                fi
                cat "$FIXTURES/diff-$(pr_num).txt"
;;
comment)
    bf=$(after_arg --body-file) || { echo 'fake-gh: comment without --body-file' >&2; exit 64; }
    if LC_ALL=C grep -q -e $'\xe2\x80\x8b' -e $'\xe2\x80\x8c' -e $'\xe2\x80\x8d' -e $'\xe2\x81\xa0' -e $'\xc2\xad' -e $'\xe2\x81\xa3' -e $'\xcc\x8f' -e $'\xef\xbb\xbf' "$bf"; then
        echo 'fake-gh: the posted body still contains zero-width characters (post the checked copy)' >&2
        exit 1
    fi
    printf 'stub: comment posted\n'
    ;;
            merge)
                local_check=$(printf '%s\n' "${args[@]}" | grep -c -- '--rebase' || true)
                mhc=$(after_arg --match-head-commit) || {
                    echo 'fake-gh: merge without --match-head-commit' >&2
                    exit 1
                }
                if [ "$mhc" != "$(head_current "$(pr_num)")" ]; then
                    echo 'fake-gh: --match-head-commit does not match the current head' >&2
                    exit 1
                fi
                if [ "$local_check" -lt 1 ]; then
                    echo 'fake-gh: merge without --rebase' >&2
                    exit 1
                fi
                if [ -e "$FIXTURES/fail-merge-$(pr_num)" ]; then
                    echo 'gh: pull request is not clean or the head moved' >&2
                    exit 1
                fi
                printf 'stub: merged\n'
                ;;
            *) echo "fake-gh: unexpected pr/$sub" >&2; exit 64 ;;
        esac
        ;;
    issue)
        check_repo_flag
        case "$sub" in
comment)
    bf=$(after_arg --body-file) || { echo 'fake-gh: comment without --body-file' >&2; exit 64; }
    if LC_ALL=C grep -q -e $'\xe2\x80\x8b' -e $'\xe2\x80\x8c' -e $'\xe2\x80\x8d' -e $'\xe2\x81\xa0' -e $'\xc2\xad' -e $'\xe2\x81\xa3' -e $'\xcc\x8f' -e $'\xef\xbb\xbf' "$bf"; then
        echo 'fake-gh: the posted body still contains zero-width characters (post the checked copy)' >&2
        exit 1
    fi
    printf 'stub: comment posted\n'
    ;;
            *) echo "fake-gh: unexpected issue/$sub" >&2; exit 64 ;;
        esac
        ;;
    run)
        check_repo_flag
        if [ -e "$FIXTURES/view-fails" ]; then
            echo 'gh: could not resolve the repository' >&2
            exit 3
        fi
        case "$sub" in
            list)
                # Real gh honors --workflow and --limit; the fixtures carry a workflow
                # field so the stub can filter, newest first.
                w=$(after_arg --workflow)
                lim=$(after_arg --limit)
                b=$(after_arg --branch) || exit 1
                f="run-$(printf '%s' "$b" | tr '/' '_').json"
                if [ -n "$w" ]; then
                    jq --arg w "$w" --argjson lim "${lim:-30}" \
                        'map(select(.workflow == $w)) | .[0:$lim]' "$FIXTURES/$f"
                else
                    head -n "${lim:-30}" "$FIXTURES/$f"
                fi
                ;;
            view)
                id=$(pr_arg)
                # The ESC token stands for an ANSI escape sequence, so the tests check
                # that tools strip them; the BOM models real --log-failed output.
                if printf '%s\n' "${args[@]}" | grep -q -- '--log-failed'; then
                    if [ -e "$FIXTURES/log-fails-$id" ]; then
                        echo 'gh: the log dump could not be produced' >&2
                        exit 4
                    fi
                    printf '\xef\xbb\xbf'
                    sed 's/ESC/\x1b/g' "$( [ -f "${GEN_DIR:-/nonexistent}/log-failed-$id.txt" ] && echo "$GEN_DIR/log-failed-$id.txt" || echo "$FIXTURES/log-failed-$id.txt" )"
                else
                    apply_jq "jobs-$id.json"
                fi
                ;;
            *) echo "fake-gh: unexpected run/$sub" >&2; exit 64 ;;
        esac
        ;;
    api)
        path=""
        for a in "${args[@]}"; do
            case $a in repos/*) path=$a; break ;; esac
        done
        check_repo_path "$path"
        case $path in
            *"branches/"*)
                base=${path##*branches/}
                apply_jq "branch-$(printf '%s' "$base" | tr '/' '_').json"
                ;;
            *"pulls/"*)
                n=$(printf '%s\n' "$path" | grep -oE 'pulls/[0-9]+' | head -n 1 | cut -d/ -f2)
                if printf '%s\n' "${args[@]}" | grep -q -- '--paginate'; then
                    if [ -f "$FIXTURES/files-$n-p1.json" ]; then
                        cat "$FIXTURES/files-$n-p1.json"
                        if [ -f "$FIXTURES/files-$n-p2.json" ]; then cat "$FIXTURES/files-$n-p2.json"; fi
                        if [ -f "$FIXTURES/files-$n-p3.json" ]; then cat "$FIXTURES/files-$n-p3.json"; fi
                    else
                        cat "$FIXTURES/files-$n.json"
                    fi
                else
                    apply_jq "files-$n.json"
                fi
                ;;
            *) echo "fake-gh: unexpected api path: $path" >&2; exit 64 ;;
        esac
        ;;
    *) echo "fake-gh: unexpected command '$cmd'" >&2; exit 64 ;;
esac
